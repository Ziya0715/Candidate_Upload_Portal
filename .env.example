# Staff login. Use one shared password for the people who upload videos.
# Change this before anyone else can reach the server.
STAFF_USERNAME=staff
STAFF_PASSWORD=change-this-password

# A long random string used to sign the login cookie.
# Create one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# DigitalOcean Spaces. The secret stays on the server and is never sent to the browser.
# Create the key in DigitalOcean: API -> Spaces Keys.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=taizo-courze1on1-bucket
DO_SPACES_REGION=sgp1
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com

# Apps Script web app that reads the private sheet. Use the /exec URL.
SHEET_SCRIPT_URL=

# Largest video accepted, in megabytes. 2048 = 2 GB.
# A single upload cannot be larger than 5120 (5 GB).
MAX_UPLOAD_MB=2048
